rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validRecord(r) {
      return r.keys().hasOnly(['kind', 'key', 'data', 'deleted', 'updatedAt'])
        && r.keys().hasAll(['kind', 'key', 'deleted', 'updatedAt'])
        && r.kind in ['day', 'application', 'contact', 'timer']
        && r.key is string && r.key.size() > 0 && r.key.size() < 160
        && r.deleted is bool && r.updatedAt == request.time
        && (r.deleted || validData(r));
    }
    function validData(r) {
      return (r.kind == 'day' && r.key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && r.data is map
          && r.data.keys().hasOnly(['tasks', 'scans', 'counts', 'legacyApplications',
            'phoneMinutes', 'phoneTarget', 'achievement', 'improvement', 'priority',
            'score', 'focusMinutes', 'focusEntries']))
        || (r.kind == 'application' && r.data is map && r.data.id == r.key
          && r.data.keys().hasOnly(['id','company','role','country','stage','date','notes'])
          && r.data.company is string && r.data.role is string
          && r.data.company.size() <= 120 && r.data.role.size() <= 160
          && r.data.notes is string && r.data.notes.size() <= 10000
          && r.data.country in ['India','UAE','Netherlands']
          && r.data.stage in ['Applied','Interview','Rejected','Offer'])
        || (r.kind == 'contact' && r.data is map && r.data.id == r.key
          && r.data.keys().hasOnly(['id','name','type','status','date','followup','notes'])
          && r.data.name is string && r.data.name.size() <= 160
          && r.data.notes is string && r.data.notes.size() <= 10000
          && r.data.type in ['Connection','Referral','Cold email']
          && r.data.status in ['Sent','Replied','Follow up','Closed'])
        || (r.kind == 'timer' && r.key == 'current' && (r.data == null
          || (r.data is map && r.data.keys().hasOnly(['id','duration','remaining','running','date','break','end'])
            && r.data.duration in [5,25,50] && r.data.running is bool)));
    }
    match /users/{uid}/records/{record} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validRecord(request.resource.data);
      // The app uses synchronized tombstones so offline devices cannot resurrect removals.
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
