{
  "firestore": {"rules": "firestore.rules"},
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", ".*", "**/.*", "node_modules/**", "legacy/**", "tests/**", "scripts/**", "work/**", "outputs/**", "**/*.md", "package*.json", "*-debug.log", "**/*.test.js"],
    "headers": [
      {"source": "sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "firebase-config.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "emulators": {
    "auth": {"port": 9099, "host": "127.0.0.1"},
    "firestore": {"port": 8081, "host": "127.0.0.1"},
    "ui": {"enabled": false},
    "singleProjectMode": true
  }
}
